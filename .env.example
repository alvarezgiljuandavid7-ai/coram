# Supabase public client config.
# Use the publishable key, never the service role key, in Vite/browser code.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
VITE_CORAM_ENABLE_APPLE_AUTH=false
# Stable HTTPS web domain used for OAuth/email callbacks in Preview and Production.
VITE_CORAM_AUTH_REDIRECT_ORIGIN="https://coram-two.vercel.app"
# Sponsored placements stay disabled unless explicitly enabled with cookie consent.
VITE_CORAM_ENABLE_SPONSORS=false

# Public native client configuration only. Never use the service-role key here.
EXPO_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
CORAM_APP_VARIANT="development"
